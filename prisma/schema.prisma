generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}
enum Visibility {
  PUBLIC
  PRIVATE
  PASSWORD
}
enum ContentStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}
enum NotificationType {
  COMMENT_REPLY
  MENTION
  LIKE
  ANNOUNCEMENT
  SYSTEM
  PROFILE_LIKE
}
enum RoomJoinMode {
  OPEN
  INVITE
}
enum AssetKind {
  AVATAR
  COVER
  CONTENT
  MOMENT
  ANIME
  ROOM
}

model User {
  id              String   @id @default(cuid())
  name            String?
  email           String?  @unique
  emailVerified   DateTime?
  username        String   @unique @default(cuid()) @db.VarChar(32)
  nickname        String   @default("New user") @db.VarChar(48)
  passwordHash    String?
  image           String?
  bio             String?  @db.VarChar(500)
  businessCard    String?  @db.VarChar(500)
  profileColor    String?  @db.VarChar(32)
  locale          String   @default("zh-CN")
  theme           String   @default("dark")
  contactLinks    String?  @db.Text
  authVersion     Int      @default(0)
  role            Role     @default(USER)
  disabledAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  accounts        Account[]
  passwordResetTokens PasswordResetToken[]
  sessions        Session[]
  notes           Note[]
  moments         Moment[]
  momentLikes     MomentLike[]
  momentReposts   MomentRepost[]
  comments        Comment[]
  notifications   Notification[]
  roomMemberships RoomMember[]
  roomsCreated    ChatRoom[] @relation("RoomCreator")
  profileLikes    ProfileLike[] @relation("ProfileLikeTarget")
  likesGiven      ProfileLike[] @relation("ProfileLikeActor")
  assets          Asset[]
  chatMessages    ChatMessage[]
  @@index([createdAt])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier,token])
}
model EmailCode {
  id String @id @default(cuid())
  email String
  codeHash String
  purpose String
  expiresAt DateTime
  consumedAt DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([email,purpose,createdAt])
}
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}

model Note {
  id String @id @default(cuid())
  slug String @unique
  title String
  excerpt String?
  content String @db.Text
  status ContentStatus @default(DRAFT)
  visibility Visibility @default(PUBLIC)
  passwordHash String?
  pinned Boolean @default(false)
  viewCount Int @default(0)
  wordCount Int @default(0)
  authorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields:[authorId],references:[id],onDelete:Restrict)
  tags NoteTag[]
  images NoteImage[]
  comments Comment[]
  @@index([status,createdAt])
  @@index([authorId,createdAt])
}
model Moment {
  id String @id @default(cuid())
  content String @db.Text
  status ContentStatus @default(PUBLISHED)
  visibility Visibility @default(PUBLIC)
  passwordHash String?
  pinned Boolean @default(false)
  viewCount Int @default(0)
  authorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields:[authorId],references:[id],onDelete:Restrict)
  images MomentImage[]
  tags MomentTag[]
  comments Comment[]
  likes MomentLike[]
  reposts MomentRepost[]
  @@index([status,createdAt])
}
model Comment {
  id String @id @default(cuid())
  body String @db.Text
  parentId String?
  noteId String?
  momentId String?
  authorId String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent Comment? @relation("CommentReplies",fields:[parentId],references:[id],onDelete:Cascade)
  replies Comment[] @relation("CommentReplies")
  note Note? @relation(fields:[noteId],references:[id],onDelete:Cascade)
  moment Moment? @relation(fields:[momentId],references:[id],onDelete:Cascade)
  author User @relation(fields:[authorId],references:[id],onDelete:Restrict)
  @@index([noteId,createdAt])
  @@index([momentId,createdAt])
  @@index([parentId])
}
model Tag {
  id String @id @default(cuid())
  name String @unique
  notes NoteTag[]
  moments MomentTag[]
}
model NoteTag {
  noteId String
  tagId String
  note Note @relation(fields:[noteId],references:[id],onDelete:Cascade)
  tag Tag @relation(fields:[tagId],references:[id],onDelete:Cascade)
  @@id([noteId,tagId])
}
model MomentTag {
  momentId String
  tagId String
  moment Moment @relation(fields:[momentId],references:[id],onDelete:Cascade)
  tag Tag @relation(fields:[tagId],references:[id],onDelete:Cascade)
  @@id([momentId,tagId])
}
model MomentImage {
  id String @id @default(cuid())
  momentId String
  assetId String
  sortOrder Int @default(0)
  moment Moment @relation(fields:[momentId],references:[id],onDelete:Cascade)
  asset Asset @relation(fields:[assetId],references:[id],onDelete:Restrict)
}
model MomentLike {
  id String @id @default(cuid())
  userId String
  momentId String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  moment Moment @relation(fields:[momentId],references:[id],onDelete:Cascade)
  @@unique([userId,momentId])
}

model Resource {
  id String @id @default(cuid())
  title String
  description String?
  url String
  coverUrl String?
  category String
  tags String[]
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AnimeEntry {
  id String @id @default(cuid())
  title String
  summary String? @db.Text
  releaseDate DateTime?
  sourceUrl String?
  coverAssetId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images AnimeImage[]
}
model AnimeImage {
  id String @id @default(cuid())
  animeId String
  assetId String
  sortOrder Int @default(0)
  anime AnimeEntry @relation(fields:[animeId],references:[id],onDelete:Cascade)
  asset Asset @relation(fields:[assetId],references:[id],onDelete:Restrict)
}

model ChatRoom {
  id String @id @default(cuid())
  name String
  description String?
  category String
  avatarUrl String?
  joinMode RoomJoinMode @default(OPEN)
  inviteCodeHash String?
  creatorId String
  createdAt DateTime @default(now())
  creator User @relation("RoomCreator",fields:[creatorId],references:[id],onDelete:Restrict)
  members RoomMember[]
  messages ChatMessage[]
}
model RoomMember {
  id String @id @default(cuid())
  roomId String
  userId String
  joinedAt DateTime @default(now())
  room ChatRoom @relation(fields:[roomId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([roomId,userId])
}
model ChatMessage {
  id String @id @default(cuid())
  roomId String
  senderId String
  sender User @relation(fields:[senderId],references:[id],onDelete:Cascade)
  body String @db.VarChar(4000)
  replyToId String?
  createdAt DateTime @default(now())
  room ChatRoom @relation(fields:[roomId],references:[id],onDelete:Cascade)
  replyTo ChatMessage? @relation("MessageReplies",fields:[replyToId],references:[id],onDelete:SetNull)
  replies ChatMessage[] @relation("MessageReplies")
  @@index([roomId,createdAt])
}

model Announcement {
  id String @id @default(cuid())
  title String
  excerpt String?
  content String @db.Text
  coverUrl String?
  published Boolean @default(false)
  authorId String
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published,publishedAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  type NotificationType
  title String
  body String?
  href String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,readAt,createdAt])
}
model ProfileLike {
  id String @id @default(cuid())
  targetId String
  actorId String
  dayKey String
  createdAt DateTime @default(now())
  target User @relation("ProfileLikeTarget",fields:[targetId],references:[id],onDelete:Cascade)
  actor User @relation("ProfileLikeActor",fields:[actorId],references:[id],onDelete:Cascade)
  @@unique([targetId,actorId,dayKey])
  @@index([targetId,dayKey])
}
model Asset {
  id String @id @default(cuid())
  ownerId String?
  kind AssetKind
  storageKey String @unique
  publicUrl String
  mimeType String
  sizeBytes Int
  sha256 String
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  owner User? @relation(fields:[ownerId],references:[id],onDelete:SetNull)
  momentImages MomentImage[]
  noteImages NoteImage[]
  animeImages AnimeImage[]
  @@index([sha256])
}
model ViewDaily {
  id String @id @default(cuid())
  contentType String
  contentId String
  dayKey String
  visitorHash String
  createdAt DateTime @default(now())
  @@unique([contentType,contentId,dayKey,visitorHash])
  @@index([contentType,contentId,dayKey])
}
model DeletionRequest {
  id String @id @default(cuid())
  userId String
  reason String @db.Text
  status String @default("PENDING")
  reviewedAt DateTime?
  reviewerId String?
  createdAt DateTime @default(now())
  @@index([status,createdAt])
}

model SiteSetting {
  key String @id
  value String @db.Text
  updatedAt DateTime @updatedAt
}

model NoteImage {
  id String @id @default(cuid())
  noteId String
  assetId String
  sortOrder Int @default(0)
  note Note @relation(fields:[noteId],references:[id],onDelete:Cascade)
  asset Asset @relation(fields:[assetId],references:[id],onDelete:Restrict)
}

model MomentRepost {
  id String @id @default(cuid())
  userId String
  momentId String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  moment Moment @relation(fields:[momentId],references:[id],onDelete:Cascade)
  @@unique([userId,momentId])
  @@index([momentId,createdAt])
}
