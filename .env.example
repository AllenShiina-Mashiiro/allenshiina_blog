# Copy to .env and replace every CHANGE_ME value. Never commit .env.
POSTGRES_USER="allenshiina"
POSTGRES_PASSWORD="CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD"
POSTGRES_DB="allenshiina_blog"
# Local host development: localhost. Docker Compose web container: db.
DATABASE_URL="postgresql://allenshiina:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@localhost:5432/allenshiina_blog?schema=public"
AUTH_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AllenShiina"
ADMIN_EMAIL=""

# OAuth - configure only providers with registered applications.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# QQ / NetEase OAuth require official app credentials and are not wired in this build.
AUTH_QQ_ID=""
AUTH_QQ_SECRET=""
AUTH_163_ID=""
AUTH_163_SECRET=""

# NetEase SMTP example. Use an app-specific authorization code, not account password.
SMTP_HOST="smtp.163.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="AllenShiina Blog <no-reply@example.com>"

REDIS_URL="redis://localhost:6379"
APP_HASH_SECRET="CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET"
CHAT_RETENTION_DAYS="180"

# Image storage: local works on Windows; choose s3 only with an S3-compatible bucket.
STORAGE_DRIVER="local"
# Keep this directory persistent and include it in backups.
UPLOAD_DIR="./data/uploads"

# S3-compatible OSS / COS / S3. Required only when STORAGE_DRIVER="s3".
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

NEXT_PUBLIC_LIVE2D_MODEL_URL=""
